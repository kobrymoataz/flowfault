{
  "name": "flowfault",
  "version": "0.2.0",
  "description": "A privacy-conscious form inspector and controlled network fault simulator for developers.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "flowfault": "./dist/cli.mjs"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "node src/cli.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "node scripts/check.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/build.mjs",
    "demo": "node scripts/demo.mjs",
    "demo:scenarios": "node scripts/scenario-demo.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test:scenarios": "node scripts/scenario-integration.mjs",
    "test:scenario-browser-offline": "node scripts/scenario-offline-browser.mjs",
    "test:browser-offline": "node scripts/integration-offline.mjs",
    "dashboard": "node src/cli.mjs dashboard --port 4173",
    "test:dashboard-browser-offline": "node scripts/dashboard-browser-offline.mjs",
    "test:dashboard-integration": "node scripts/dashboard-integration.mjs"
  },
  "keywords": [
    "forms",
    "quality-assurance",
    "chrome-devtools-protocol",
    "testing",
    "website-inspection",
    "fault-injection",
    "network-testing",
    "open-source"
  ]
}
